{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "declaration": true,
    "moduleResolution": "Bundler",
    "strict": false,
    "rootDir": "src",
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "allowJs": true,
    "lib": [
      "dom",
    ]
  },
  "exclude": [
    "node_modules/**/*",
    "**/*.test.ts"
  ],
  "include": [
    "src"
  ]
}
