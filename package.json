{
  "name": "brotli-compress",
  "version": "2.0.0",
  "description": "WASM based, asynchronous Brotli compression and decompression package that works in browsers and Node.js; CommonJS and ESM",
  "keywords": [
    "brotli",
    "compress",
    "decompress",
    "wasm",
    "webassemly",
    "async",
    "typescript",
    "browser",
    "Node.js"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsx ./build.ts",
    "postbuild": "tsc",
    "deploy": "npm publish",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./js": {
      "types": "./dist/js.d.ts",
      "import": "./js.mjs",
      "require": "./js.cjs"
    },
    "./index.js": "./index.cjs",
    "./index.mjs": "./index.mjs",
    "./index.cjs": "./index.cjs",
    "./js.js": "./js.cjs",
    "./js.mjs": "./js.mjs",
    "./js.cjs": "./js.cjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyr0/brotli-compress.git"
  },
  "author": "Aron Homberg <info@aron-homberg.de>, Tim Perry <tim@httptoolkit.tech>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kyr0/brotli-compress/issues"
  },
  "homepage": "https://github.com/kyr0/brotli-compress#readme",
  "dependencies": {
    "@types/node": "^26.1.1",
    "brotli-wasm-custom-dictionary": "^3.1.0"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.1",
    "pkgroll": "^2.27.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}